#!/usr/bin/env sh
# chromakey — POSIX Shell Thin Adapter delegating to scripts/chromakey.py
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
CHROMAKEY_PY="$SCRIPT_DIR/../scripts/chromakey.py"

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$CHROMAKEY_PY" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$CHROMAKEY_PY" "$@"
else
    echo "[ERROR] Python 3.10+ is required but not found on PATH." >&2
    exit 1
fi
